#!/usr/bin/env bash
# build/mcp — cross-compile the mcpd daemon and produce a self-contained install
# package, then optionally scp it to a host and run the installer over ssh. Same
# packager model as netstar-labs/inbox/build/inbox.
#
#   build/mcp [--cli|--server] [user@host]
#
#   --cli (default)  install the mcpd binary only, no service
#   --server         also install a systemd unit serving mcpd on a Unix socket
#
# With no host the package is built under build/install/ but not transmitted.

set -eu

MODE=cli
case "${1:-}" in
    --cli)    MODE=cli;    shift ;;
    --server) MODE=server; shift ;;
esac

BINARY=mcpd
APP=./app/mcpd
BIN=/usr/local/bin
SYSTEMD=/etc/systemd/system
SOCK=/run/mcpd/mcpd.sock
RUNUSER=mcpd
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
export GOWORK=off

SERVICE=$BINARY.service
HISTORY=$BINARY.version
INSTALLER=$BINARY.sh
PACKAGE=$BINARY.tgz

HOST=${1:-}
if [ -z "$HOST" ] && [ -e build/host ]; then
    HOST=$(cat build/host)
fi

BUILD=$ROOT/build
INSTALL=$BUILD/install
rm -rf "$INSTALL"
mkdir -p "$INSTALL"

VERSION=$(git describe --tags 2>/dev/null || echo dev)
REVISION=$(git rev-parse --short=12 HEAD 2>/dev/null || echo none)
LDFLAGS="-s -w -X main.version=$VERSION -X main.build=$REVISION"

echo "VERSION  $VERSION $REVISION"
echo "MODE     $MODE"
echo "BUILD    $BINARY ($APP) -> linux/amd64"
date -u +%Y.%m.%d.%H.%M | tr '\n' ' ' >> "$INSTALL/$HISTORY"
echo "$VERSION $REVISION $BINARY $MODE" >> "$INSTALL/$HISTORY"
GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "$LDFLAGS" -o "$INSTALL/$BINARY" "$APP"

if [ "$MODE" = "server" ]; then
    echo "CREATE   $SERVICE (mcpd on $SOCK)"
    cat > "$INSTALL/$SERVICE" << EOF
[Unit]
Description=mcpd — MCP server
After=network-online.target

[Service]
User=$RUNUSER
Group=$RUNUSER
RuntimeDirectory=mcpd
ExecStart=$BIN/$BINARY -socket $SOCK -mode 0660
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
EOF
fi

echo "BUILD    $INSTALLER"
{
cat << EOF_HEAD
#!/bin/sh
# generated by build/mcp — installs $BINARY ($MODE)
set -eu
INSTALL=install
PACKAGE=$PACKAGE
HISTORY=$HISTORY
BINARY=$BINARY
MODE=$MODE
SERVICE=$SERVICE
BIN=$BIN
SYSTEMD=$SYSTEMD
RUNUSER=$RUNUSER
EOF_HEAD
cat << 'EOF_BODY'

[ "$(id -u)" = 0 ] || { echo "installer: run as root (sudo ./mcpd.sh)"; exit 1; }
rm -rf "$INSTALL"
tar -xzf "$PACKAGE"
mkdir -p "$BIN/version"
mv "$INSTALL/$HISTORY" "$BIN/version/"
cp "$INSTALL/$BINARY" "$BIN/"
chmod 0755 "$BIN/$BINARY"
echo "install: $BINARY -> $BIN/$BINARY"

if [ "$MODE" = "server" ] && command -v systemctl >/dev/null 2>&1; then
    id "$RUNUSER" >/dev/null 2>&1 || useradd -r -s /sbin/nologin "$RUNUSER" 2>/dev/null || true
    cp "$INSTALL/$SERVICE" "$SYSTEMD/"
    systemctl daemon-reload
    if systemctl is-enabled "$SERVICE" >/dev/null 2>&1; then
        systemctl restart "$SERVICE"; echo "install: $SERVICE restarted"
    else
        systemctl enable --now "$SERVICE"; echo "install: $SERVICE enabled"
    fi
fi

rm -rf "$INSTALL" "$PACKAGE" mcpd.sh
echo "install: complete"
EOF_BODY
} > "$INSTALL/$INSTALLER"
chmod a+x "$INSTALL/$INSTALLER"

echo "BUILD    $PACKAGE"
tar -czf "$BUILD/$PACKAGE" -C "$BUILD" install
mv "$BUILD/$PACKAGE" "$INSTALL/$PACKAGE"

if [ -n "$HOST" ]; then
    echo "TRANSMIT $PACKAGE + $INSTALLER -> $HOST"
    scp "$INSTALL/$PACKAGE" "$INSTALL/$INSTALLER" "$HOST:"
    echo "RUN      $HOST: sudo ./$INSTALLER"
    ssh "$HOST" "sudo ./$INSTALLER"
    rm -rf "$INSTALL"
else
    echo "PACKAGE  $INSTALL/$PACKAGE"
    echo "         (no host — scp this package + $INSTALLER to a server and run sudo ./$INSTALLER)"
fi
echo "bye"
